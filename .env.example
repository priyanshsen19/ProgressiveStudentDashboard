# ---- Backend (server/.env) ----
# SQLite database file (relative to server/prisma). Swap to a Postgres URL to use Postgres.
DATABASE_URL="file:./dev.db"
# Secret used to sign JWTs. Use a long random string. DO NOT commit the real value.
JWT_SECRET="change-me-to-a-long-random-string"
# Port the API listens on.
PORT=4000
# Comma-separated origins allowed by CORS (the frontend dev origin).
CORS_ORIGIN="http://localhost:5173"

# ---- Frontend (client/.env) ----
# Base URL the browser uses to reach the API. Leave empty to use the Vite dev proxy (/api).
VITE_API_URL=""
